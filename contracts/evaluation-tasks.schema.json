{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r1ck29.github.io/claude-code-codegraph-harness/contracts/evaluation-tasks.schema.json",
  "title": "Codegraph evaluation task suite",
  "type": "object",
  "required": ["schema_version", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "prompt": {
            "type": "string"
          },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required_substrings", "forbidden_substrings"],
            "properties": {
              "required_substrings": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 300}
              },
              "forbidden_substrings": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
