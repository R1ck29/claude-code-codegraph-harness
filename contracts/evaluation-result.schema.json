{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r1ck29.github.io/claude-code-codegraph-harness/contracts/evaluation-result.schema.json",
  "title": "Codegraph evaluation result",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "evaluation",
    "summary",
    "next_actions",
    "artifacts",
    "preparations",
    "runs"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "sha256", "stored"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["stdout", "stderr", "mcp_config"]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stored": {
          "type": "boolean"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(raw|state)/[A-Za-z0-9_.\\/-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stored": {"const": true}
            },
            "required": ["stored"]
          },
          "then": {
            "required": ["relative_path"]
          },
          "else": {
            "not": {
              "required": ["relative_path"]
            }
          }
        }
      ]
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "reasoning_output_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_creation_input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cache_write_input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "toolCalls": {
      "type": "object",
      "required": ["available", "count", "by_tool"],
      "additionalProperties": false,
      "properties": {
        "available": {"type": "boolean"},
        "count": {"type": ["integer", "null"], "minimum": 0},
        "by_tool": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z0-9_.-]+$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"available": {"const": true}}, "required": ["available"]},
          "then": {"properties": {"count": {"type": "integer"}}},
          "else": {
            "properties": {
              "count": {"type": "null"},
              "by_tool": {"maxProperties": 0}
            }
          }
        }
      ]
    },
    "oracle": {
      "type": "object",
      "required": ["configured", "passed", "required_matched", "required_total", "forbidden_matched"],
      "additionalProperties": false,
      "properties": {
        "configured": {"type": "boolean"},
        "passed": {"type": ["boolean", "null"]},
        "required_matched": {"type": "integer", "minimum": 0},
        "required_total": {"type": "integer", "minimum": 0},
        "forbidden_matched": {"type": "integer", "minimum": 0}
      }
    },
    "process": {
      "type": "object",
      "required": ["status", "returncode", "error", "duration_ms", "artifacts"],
      "properties": {
        "status": {
          "enum": ["succeeded", "failed", "blocked", "not_required"]
        },
        "returncode": {"type": ["integer", "null"]},
        "error": {"type": ["string", "null"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["completed", "completed_with_failures"]},
    "evaluation": {
      "type": "object",
      "required": [
        "seed",
        "repetitions",
        "conditions",
        "clients",
        "variants",
        "condition_data_policies",
        "repo_path_sha256",
        "harness_path_sha256",
        "data_classification",
        "security_evidence_sha256",
        "repo_is_disposable_copy",
        "store_raw_artifacts",
        "environment_policy",
        "task_suite_sha256",
        "conditions_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "seed": {"type": "integer"},
        "repetitions": {"type": "integer", "minimum": 1},
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "clients": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["claude", "codex"]}
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["baseline", "graph-gateway", "legacy-candidate"]}
        },
        "condition_data_policies": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"const": "public-fixture"}
          }
        },
        "repo_path_sha256": {"$ref": "#/$defs/sha256"},
        "harness_path_sha256": {"$ref": "#/$defs/sha256"},
        "data_classification": {
          "const": "public-fixture"
        },
        "security_evidence_sha256": {
          "type": "null"
        },
        "repo_is_disposable_copy": {"type": "boolean"},
        "store_raw_artifacts": {"type": "boolean"},
        "environment_policy": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "minimum_environment_names",
              "explicit_environment_names",
              "prepare_inherit_environment",
              "command_inherit_environment"
            ],
            "additionalProperties": false,
            "properties": {
              "minimum_environment_names": {
                "type": "array",
                "items": {"type": "string"}
              },
              "explicit_environment_names": {
                "type": "array",
                "items": {"type": "string"}
              },
              "prepare_inherit_environment": {
                "type": "array",
                "items": {"type": "string"}
              },
              "command_inherit_environment": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        },
        "task_suite_sha256": {"$ref": "#/$defs/sha256"},
        "conditions_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_runs", "succeeded", "failed", "state_cleanup", "by_condition"],
      "additionalProperties": false,
      "properties": {
        "total_runs": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "state_cleanup": {"enum": ["succeeded", "failed"]},
        "by_condition": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "client", "variant", "total_runs", "succeeded", "failed",
              "oracle_passed", "oracle_total", "median_input_tokens",
              "median_cached_input_tokens", "median_output_tokens",
              "tool_calls_observed", "tool_call_runs_observed"
            ],
            "additionalProperties": false,
            "properties": {
              "total_runs": {"type": "integer", "minimum": 0},
              "succeeded": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0}
              ,"client": {"enum": ["claude", "codex"]}
              ,"variant": {"enum": ["baseline", "graph-gateway", "legacy-candidate"]}
              ,"oracle_passed": {"type": "integer", "minimum": 0}
              ,"oracle_total": {"type": "integer", "minimum": 0}
              ,"median_input_tokens": {"type": ["number", "null"], "minimum": 0}
              ,"median_cached_input_tokens": {"type": ["number", "null"], "minimum": 0}
              ,"median_output_tokens": {"type": ["number", "null"], "minimum": 0}
              ,"tool_calls_observed": {"type": "integer", "minimum": 0}
              ,"tool_call_runs_observed": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "preparations": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/process"},
          {
            "type": "object",
            "required": ["condition"],
            "properties": {
              "condition": {"type": "string"},
              "step": {"type": "integer", "minimum": 0}
            }
          }
        ],
        "unevaluatedProperties": false
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/process"},
          {
            "type": "object",
            "required": [
              "condition",
              "client",
              "variant",
              "task",
              "prompt_sha256",
              "seed",
              "repetition",
              "usage",
              "cost_usd",
              "tool_calls",
              "oracle",
              "final_response_sha256"
            ],
            "properties": {
              "condition": {"type": "string"},
              "client": {"enum": ["claude", "codex"]},
              "variant": {"enum": ["baseline", "graph-gateway", "legacy-candidate"]},
              "task": {"type": "string"},
              "prompt_sha256": {"$ref": "#/$defs/sha256"},
              "seed": {"type": "integer"},
              "repetition": {"type": "integer", "minimum": 0},
              "usage": {"$ref": "#/$defs/usage"},
              "cost_usd": {"type": ["number", "null"], "minimum": 0},
              "tool_calls": {"$ref": "#/$defs/toolCalls"},
              "oracle": {"$ref": "#/$defs/oracle"},
              "final_response_sha256": {
                "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
              }
            }
          }
        ],
        "unevaluatedProperties": false
      }
    }
  }
}
